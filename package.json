{
  "name": "gluco-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "糖尿病及糖尿病前期运动干预研究的检索、筛选与数据提取工作台",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.json --persist-to .wrangler/state",
    "dev": "npm run db:local && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vinext build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "imports": {
    "#gluco-terms": "./research/default-terms.json"
  }
}
